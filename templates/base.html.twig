<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{% endblock %}</title>
    {{ importmap('app') }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>

<header id="menu">
    {{ include('_menu.html.twig') }}
</header>

<main class="container-fluid">
    <turbo-frame id="content">
        {% block body %}{% endblock %}
    </turbo-frame>
</main>

<footer class="player fixed-bottom bg-dark text-white p-2" data-turbo-permanent id="turbo-player">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-md-3 col-sm-4">
                <div class="d-flex align-items-center">
                    <div class="me-2">
                        <div id="player-cover" class="player-cover bg-secondary rounded">
                            <span class="player-cover-icon">🎵</span>
                        </div>
                    </div>
                    <div>
                        <div id="player-title" class="fw-bold text-truncate">Не выбрано</div>
                        <div id="player-artist" class="text-muted small text-truncate"></div>
                    </div>
                </div>
            </div>

            <div class="col-md-7 col-sm-6">
                <div class="d-flex align-items-center gap-3">
                    <button id="player-play" class="btn btn-primary btn-sm rounded-circle player-btn">
                        <i class="bi bi-play-fill"></i>
                    </button>

                    <div class="flex-grow-1">
                        <div id="player-waveform" class="player-waveform"></div>
                        <div class="d-flex justify-content-between mt-1">
                            <span id="player-time" class="small">0:00</span>
                            <span id="player-duration" class="small">0:00</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-2 col-sm-2 text-end">
                <button id="player-volume" class="btn btn-sm btn-link text-white">
                    <i class="bi bi-volume-up-fill"></i>
                </button>
                <button id="player-repeat" class="btn btn-sm btn-link text-white">
                    <i class="bi bi-repeat"></i>
                </button>
            </div>
        </div>
    </div>
</footer>

{% if not app.session.get('cookies_accepted') %}
    <div id="cookie-banner" class="cookie-banner">
        <div class="cookie-banner__content">
            <p class="cookie-banner__text">
                Мы используем файлы cookie для улучшения работы сайта.
                Продолжая использовать сайт, вы соглашаетесь с нашей
                <a href="{{ path('app_privacy') }}" target="_blank">политикой конфиденциальности</a>.
            </p>
            <div class="cookie-banner__actions">
                <button id="cookie-accept" class="btn btn-primary">Принять</button>
                <button id="cookie-decline" class="btn btn-secondary">Отказаться</button>
            </div>
        </div>
    </div>
{% endif %}
{% block javascripts %}{% endblock %}
</body>
</html>
