<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}mymixes{% endblock %}</title>
    {% block stylesheets %}
        {{ importmap('app') }}
    {% endblock %}
    {% block head %}{% endblock %}
</head>
<body>

<header id="menu">
    {{  include('_menu.html.twig') }}
</header>

<main class="container-fluid">
    <turbo-frame id="content">
        {% block body %}{% endblock %}
    </turbo-frame>

    {% if app.request.host != 'kuba.msk.ru' %}
        <!-- Yandex.Metrika informer -->
        <a href="https://metrika.yandex.ru/stat/?id=111010655&amp;from=informer" target="_blank" rel="nofollow">
            <img src="https://informer.yandex.ru/informer/111010655/3_1_FFFFFFFF_EFEFEFFF_0_pageviews"
                 style="width:88px; height:31px; border:0;"
                 alt="Яндекс.Метрика"
                 title="Яндекс.Метрика: данные за сегодня (просмотры, визиты и уникальные посетители)"
            />
        </a>
        <!-- /Yandex.Metrika informer -->

        <!-- Yandex.Metrika counter -->
        <script type="text/javascript">
            (function(m,e,t,r,i,k,a){
                m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
                m[i].l=1*new Date();
                for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
                k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
            })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=111010655', 'ym');

            ym(111010655, 'init', {ssr:true, webvisor:true, trackHash:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
        </script>
        <noscript><div><img src="https://mc.yandex.ru/watch/111010655" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
        <!-- /Yandex.Metrika counter -->
    {% endif %}
</main>

<footer class="player fixed-bottom bg-dark text-white p-2" data-turbo-permanent id="turbo-player">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-3">🎵 Now playing</div>
            <div class="col-6 text-center">
                <audio id="player" controls class="w-100" data-track-id="1">
                    <source src="https://lj.aftaa.ru/music/mixes/download123.mp3" type="audio/mpeg">
                </audio>
            </div>
            <div class="col-3 text-end">
            </div>
        </div>
    </div>
</footer>

{# templates/base.html.twig #}

{% if not app.session.get('cookies_accepted') %}
    <div id="cookie-banner" class="cookie-banner">
        <div class="cookie-banner__content">
            <p class="cookie-banner__text">
                Мы используем файлы cookie для улучшения работы сайта.
                Продолжая использовать сайт, вы соглашаетесь с нашей
                <a href="{{ path('app_privacy') }}" target="_blank">политикой конфиденциальности</a>.
            </p>
            <div class="cookie-banner__actions">
                <button id="cookie-accept" class="btn btn-primary">Принять</button>
                <button id="cookie-decline" class="btn btn-secondary">Отказаться</button>
            </div>
        </div>
    </div>
{% endif %}

</body>
</html>
