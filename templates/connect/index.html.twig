{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block body %}
    <div class="auth-wrapper">
        <div class="auth-card">
            <h1 class="auth-title">🎵 Добро пожаловать</h1>
            <p class="auth-subtitle">Войдите, чтобы загружать и слушать миксы</p>

            <a href="{{ url('connect_yandex_start') }}" class="auth-btn auth-btn-yandex" data-turbo="false">
                <svg width="80" height="24" viewBox="0 0 80 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <text x="0" y="16" font-family="Arial, sans-serif" font-weight="bold" font-size="18" fill="white">Яндекс</text>
                </svg>
            </a>

            <br><br>

            <a href="" class="auth-btn auth-btn-google" data-turbo="false">
                <svg width="80" height="24" viewBox="0 0 80 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <text x="0" y="16" font-family="Arial, sans-serif" font-weight="bold" font-size="18" fill="#1a1a2e">Google</text>
                </svg>
            </a>

            <p class="auth-footer">
                Продолжая, вы соглашаетесь с нашей
                <a href="{{ path('app_privacy') }}">политикой конфиденциальности</a>
            </p>
        </div>
    </div>
{% endblock %}
