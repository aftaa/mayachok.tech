{% extends 'base.html.twig' %}

{% block body %}
    <div id="yandex-auth-container" class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <!-- Сюда Яндекс вставит виджет -->
    </div>

    <script>
        // 1. Объявляем функцию инициализации ДО загрузки скрипта
        function initYandexAuth() {
            if (typeof YaAuthSuggest === 'undefined') {
                console.warn('YaAuthSuggest not loaded yet, waiting...');
                return;
            }

            // Защита от повторной инициализации
            if (window._yandexAuthInitialized) return;
            window._yandexAuthInitialized = true;

            YaAuthSuggest.init(
                {
                    client_id: 'ce72120c92114b4e9ec16be7f444898c',
                    response_type: 'token',
                    redirect_uri: '{{ url('app_yandex_auth_callback') }}',
                },
                '{{ url('app_connect') }}'
            )
                .then(({handler}) => handler())
                .then(yandexData => {
                    // 1. Получить данные пользователя от Яндекса
                    return fetch('https://login.yandex.ru/info?format=json', {
                        headers: { Authorization: `Bearer ${yandexData.access_token}` }
                    })
                        .then(res => {
                            if (!res.ok) throw new Error('Не удалось получить данные пользователя');
                            return res.json();
                        })
                        .then(user => {
                            const avatarUrl = user.default_avatar_id
                                ? `https://avatars.yandex.net/get-yapic/${user.default_avatar_id}/islands-200`
                                : '';

                            // 2. Отправить данные на бэкенд
                            return fetch('{{ url('api_auth_yandex') }}', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    token: yandexData.access_token,
                                    email: user.default_email,
                                    displayName: user.login,
                                    avatarUrl: avatarUrl,
                                    yandexId: user.id,
                                })
                            })
                                .then(res => res.json())
                                .then(authResult => {
                                    if (!authResult.success) {
                                        throw new Error(authResult.error || 'Ошибка авторизации на сервере');
                                    }
                                    // 3. Обновить меню
                                    return fetch('/_menu?rand=' + Math.random())
                                        .then(res => res.text())
                                        .then(html => {
                                            document.getElementById('menu').innerHTML = html;
                                        });
                                });
                        });
                })
                .catch(error => {
                    console.error('Ошибка авторизации:', error);
                });
        }

        // 2. Загружаем скрипт только если не загружен
        function loadYandexSDK() {
            if (typeof YaAuthSuggest !== 'undefined') {
                initYandexAuth();
                return;
            }

            const script = document.createElement('script');
            script.src = 'https://yastatic.net/s3/passport-sdk/autofill/v1/sdk-suggest-with-polyfills-latest.js';
            script.onload = initYandexAuth;
            script.onerror = function () {
                console.error('Ошибка загрузки Яндекс SDK');
                document.getElementById('yandex-auth-container').innerHTML = 'Не удалось загрузить виджет входа';
            };
            document.head.appendChild(script);
        }

        // 3. Запускаем при загрузке страницы и при Turbo-переходах
        function tryInit() {
            // Проверяем, есть ли контейнер на странице
            if (!document.getElementById('yandex-auth-container')) return;
            // Если пользователь уже залогинен — не надо
            {% if app.user %} return; {% endif %}

            loadYandexSDK();
        }

        document.addEventListener('DOMContentLoaded', tryInit);
        document.addEventListener('turbo:load', tryInit);
    </script>
{% endblock %}
