{% extends 'base.html.twig' %}

{% block title %}Музыкальные миксы{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">🎵 Миксы</h1>
            {% if app.user %}
                <a href="{{ path('app_upload') }}" class="btn btn-primary" data-turbo-frame="content" data-turbo-action="advance">
                    <i class="bi bi-plus-circle"></i> Загрузить микс
                </a>
            {% endif %}
        </div>

        {% if mixes is empty %}
            <div class="text-center py-5">
                <div class="display-1 mb-3">🎧</div>
                <h3>Пока нет миксов</h3>
                <p class="text-muted">Будьте первым, кто загрузит свой микс!</p>
                {% if app.user %}
                    <a href="{{ path('app_upload') }}" class="btn btn-primary mt-3" data-turbo-frame="content" data-turbo-action="advance">Загрузить микс</a>
                {% else %}
                    <a href="{{ path('connect_index') }}" class="btn btn-primary mt-3" data-turbo-frame="content" data-turbo-action="advance">Войти чтобы загрузить</a>
                {% endif %}
            </div>
        {% else %}
            <div class="row g-3">
                {% for mix in mixes %}
                    <div class="col-12">
                        <div class="card mix-card h-100 shadow-sm"
                             data-mix-uuid="{{ mix.uuid }}"
                             data-mix-id="{{ mix.id }}">

                            <div class="row g-0 h-100">
                                {# Обложка #}
                                <div class="col-md-3 col-lg-2 mix-cover-wrapper">
                                    <div class="mix-cover" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                        <div class="mix-cover-content">
                                            <span class="mix-cover-icon">🎵</span>
                                            <span class="mix-duration">{{ mix.duration|duration }}</span>
                                        </div>
                                        <div class="mix-playing-indicator" style="display: none;">
                                            <span class="playing-dot"></span>
                                            <span class="playing-text">Сейчас играет</span>
                                        </div>
                                    </div>
                                </div>

                                {# Информация #}
                                <div class="col-md-9 col-lg-10">
                                    <div class="card-body d-flex flex-column h-100">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h5 class="card-title mb-1">
                                                    <a href="{{ path('app_mix_show', {uuid: mix.uuid}) }}"
                                                       class="text-decoration-none text-dark mix-title-link"
                                                       data-turbo-frame="content" data-turbo-action="advance">
                                                        {{ mix.title }}
                                                    </a>
                                                </h5>
                                                <p class="card-text text-muted mb-2">
                                                    <i class="bi bi-person"></i> {{ mix.artist }}
                                                </p>
                                            </div>
                                            <div class="ms-2">
                                                <button class="btn btn-sm btn-outline-primary play-btn mix-play-btn"
                                                        data-mix-uuid="{{ mix.uuid }}"
                                                        data-title="{{ mix.title }}"
                                                        data-artist="{{ mix.artist }}"
                                                        data-peaks-url="{{ mix.s3PeaksUrl ?? null }}"
                                                        data-duration="{{ mix.duration }}">
                                                    <i class="bi bi-play-circle-fill"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="mt-auto">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <small class="text-muted">
                                                    <i class="bi bi-clock"></i>
                                                    {{ mix.duration|duration }}
                                                </small>
                                                <div class="mix-controls">
                                                    <button class="btn btn-sm btn-link text-muted p-0 me-2 like-btn"
                                                            data-mix-id="{{ mix.id }}">
                                                        <i class="bi bi-heart"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-link text-muted p-0 share-btn"
                                                            data-mix-id="{{ mix.id }}">
                                                        <i class="bi bi-share"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="mix-progress-container">
                                                <div class="mix-progress-bar" style="width: 0%;"></div>
                                            </div>

                                            {% if mix.isProcessed %}
                                                <div class="waveform-static"
                                                     data-mix-uuid="{{ mix.uuid }}"
                                                     data-mix-id="{{ mix.id }}"
                                                     data-peaks-url="{{ mix.s3PeaksUrl ?? null }}"
                                                     style="position: relative; min-height: 32px; background: rgba(108, 99, 255, 0.04); border-radius: 6px; padding: 2px 0; overflow: hidden;">
                                                    <canvas class="waveform-canvas" height="32" style="width: 100%; height: 32px; display: block;"></canvas>
                                                    <div class="waveform-click-overlay"
                                                         data-mix-uuid="{{ mix.uuid }}"
                                                         style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; cursor: pointer; z-index: 2; border-radius: 6px;"></div>
                                                    <div class="waveform-progress-overlay"
                                                         style="position: absolute; top: 0; left: 0; height: 100%; width: 0%; background: rgba(108, 99, 255, 0.12); border-radius: 6px; pointer-events: none; transition: width 0.1s linear; z-index: 1;"></div>
                                                </div>
                                            {% else %}
                                                <div class="text-center text-muted py-2">
                                                    <small>⏳ Обработка...</small>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
