{% set currentUrl = app.request.uri %}
<nav class="navbar navbar-expand-sm bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ url('app_index') }}" data-turbo-frame="content" data-turbo-action="advance">🎵 mymixes.ru {{ rand ?? 'rand' }}</a>
        <ul class="navbar-nav ms-auto">
            <li class="nav-item">
                <a class="nav-link{{ currentUrl == path('app_index') ? ' active' : '' }}" href="{{ url('app_index') }}" data-turbo-frame="content" data-turbo-action="advance">Index</a>
            </li>
            <li class="nav-item">
                {% if app.user %}
                    <a class="nav-link" href="">Logout</a>
                {% else %}
                    <a class="nav-link{{ currentUrl == path('app_connect') ? ' active' : '' }}" href="{{ url('app_connect') }}" data-turbo-frame="content" data-turbo-action="advance">Connect</a>
                {% endif %}
            </li>
            <li class="nav-item">
                <a class="nav-link{{ currentUrl == path('app_privacy') ? ' active' : '' }}" href="{{ url('app_privacy') }}" data-turbo-frame="content" data-turbo-action="advance">Privacy</a>
            </li>
        </ul>
    </div>
</nav>
