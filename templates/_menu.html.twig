{% set currentUrl = app.request.uri %}
<nav class="navbar navbar-expand-sm bg-body-tertiary">
    <div class="container-fluid">
        <a class="navbar-brand" href="{{ url('app_index') }}" data-turbo-frame="content" data-turbo-action="advance">🎵
            MyMixes.Ru</a>
        <ul class="navbar-nav ms-auto">
            {% if app.user %}
                <li class="nav-link">
                    <img alt="" src="{{ app.user.avatarUrl }}" height="42" id="menu-avatar">
                </li>
                <li class="nav-link">
                    <strong>Привет, {{ app.user.displayName }}!</strong>
                </li>
            {% else %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('connect_index') }}" data-turbo-frame="content" data-turbo-action="advance">Connect</a>
                </li>
            {% endif %}
            <li class="nav-item">
                <a class="nav-link{{ currentUrl == url('app_privacy') ? ' active' : '' }}"
                   href="{{ url('app_privacy') }}" data-turbo-frame="content" data-turbo-action="advance">Privacy</a>
            </li>
            {% if app.user %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_upload') }}" data-turbo-frame="content" data-turbo-action="advance">Upload</a>
                </li>
{#                <li class="nav-item">#}
{#                    <a class="nav-link" href="{{ url('app_logout') }}">Profile</a>#}
{#                </li>#}
                <li class="nav-item">
                    <a class="nav-link" href="{{ url('app_logout') }}" onclick="return confirm('Уверены?');" data-turbo="false">Logout</a>
                </li>
            {% endif %}

            {% if app.request.host != 'kuba.msk.ru' %}
                <li class="nav-item">
                    {% include '_metrika.html.twig' %}
                </li>
            {% endif %}
        </ul>
    </div>
</nav>
